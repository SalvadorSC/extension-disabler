    "48": "images/icon48.png"
  },
  "key": "",
  "manifest_version": 3,
  "name": "Extension Disabler for Localhost and websites",
  "permissions": [
    "storage",
    "tabs",
    "management"
  ],
  "version": "1.2.0"
}
